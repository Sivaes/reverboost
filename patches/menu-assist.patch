+// The work is done in the physics selector hook (no_bail.cpp). This tick reads D-pad Right, publishes it,
+// and reports each time the "D-pad menu open" flag was cleared early. Nothing is read until it is switched on.
+namespace {
+void menu_assist_tick(InteractiveDebug& debug, bool ready) {
+    if (!debug.menu_assist) { menu_assist_update(false, false); return; }
+    const bool allowed = ready && session_boosts_allowed() && !debug.noclip && !debug.park_editor;
+    ControllerInput pad;
+    DingoSDKOverlayReadControllerInput(&pad);
+    menu_assist_update(allowed, pad.available && (pad.buttons & 0x8) != 0);
+    const auto cleared = menu_assist_count();
+    if (cleared != debug.menu_assist_seen) {
+        debug.menu_assist_seen = cleared;
+        logging::write(logging::Level::info, logging::Channel::skater,
+            "Dark pop menu assist: cleared the D-pad menu flag early so the landing sees a closed menu");
+    }
+}
