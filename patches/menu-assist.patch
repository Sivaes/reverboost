     ReleaseSRWLockExclusive(&p.lock);
 }
+void menu_assist_update(bool enabled, bool dpad_down) noexcept {
+    auto& m = menu_assist();
+    m.enabled.store(enabled, std::memory_order_relaxed);
+    if (enabled && dpad_down) m.down_until.store(GetTickCount64() + 120, std::memory_order_relaxed);
+}
+std::uint64_t menu_assist_count() noexcept { return menu_assist().cleared.load(std::memory_order_acquire); }
