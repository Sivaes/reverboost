+struct ContactAssist {
+    std::atomic<bool> enabled{};
+    std::atomic<std::uint64_t> armed_until{}, cleared{}; // armed_until: D-pad Right was down until this time
+    std::atomic<unsigned> last_mask{};
+    std::atomic<bool> latched{}; // the D-pad menu was brought up during the current flight
+    std::atomic<bool> consumed{}; // the game already chose a pop in this flight: the latch is spent until touchdown
+    std::atomic<std::uint64_t> pop_until{}, holds{}; // pop_until: the game chose the pop, protect it until this time
+    std::atomic<std::uint64_t> hold_since{}; // when the current run of held-off wipeouts/dismounts began
+};
+ContactAssist& contact_assist() { static auto* value = new ContactAssist; return *value; }
+// The "bail package". In 38 recorded dark pop attempts the game raised these on the tick before it chose to
+// bail (state 504) and never in an attempt that popped: context+0x13c4 bit 0x8000, +0x13c8 bits 0x2c000,
+// +0x13cc bit 0x400 (landing contact) and +0x13d4 bit 0x100 (the dismount request). A pop has the landing
+// stage (+0x13c8 bit 0x4000000) without them.
+struct BailFlag { std::uintptr_t offset; unsigned mask; };
+constexpr BailFlag bail_flags[] = {{0x13c4, 0x8000}, {0x13c8, 0x2c000}, {0x13cc, 0x400}, {0x13d4, 0x100}};
+constexpr unsigned landing_stage_bit = 0x4000000;
+void contact_assist_apply(std::uintptr_t selector, std::uint32_t current) noexcept {
+    auto& a = contact_assist();
+    if (!a.enabled.load(std::memory_order_relaxed)) return;
+    Owner owner;
+    if (!local_owner(selector, &Owner::selector, &owner)) return;
+    // On the ground everything starts over (except for the landing right after a pop, see below). In the air,
+    // bringing the menu up at any point latches it for the rest of the flight, so the landing no longer
+    // depends on exactly when the D-pad is let go.
+    const auto now = GetTickCount64();
+    const bool pop_window = now < a.pop_until.load(std::memory_order_relaxed);
+    if (current < 200 || current >= 300) {
+        a.latched.store(false, std::memory_order_relaxed);
+        a.consumed.store(false, std::memory_order_relaxed);
+        if (!pop_window || current >= 300) return; // the landing after a pop is still protected, off the board is not
+    }
+    if (now < a.armed_until.load(std::memory_order_relaxed) && !a.consumed.load(std::memory_order_relaxed))
+        a.latched.store(true, std::memory_order_relaxed);
+    if (!pop_window && (current != 201 || !a.latched.load(std::memory_order_relaxed))) return;
+    if (pop_window && current >= 300) return;
+    unsigned landing{};
+    // Before the pop: only at the landing stage. During the pop's first moments: whenever.
+    if (!pop_window && (!read(owner.context + 0x13c8, landing) || !(landing & landing_stage_bit))) return;
+    unsigned found = 0;
+    for (unsigned i = 0; i < std::size(bail_flags); ++i) {
+        unsigned word{};
+        if (read(owner.context + bail_flags[i].offset, word) && (word & bail_flags[i].mask)) found |= 1u << i;
+    }
+    if (!found) return;
+    for (unsigned i = 0; i < std::size(bail_flags); ++i)
+        if (found & (1u << i)) cancel_request(owner.context, bail_flags[i].offset, static_cast<LONG>(bail_flags[i].mask));
+    a.last_mask.store(found, std::memory_order_relaxed);
+    a.cleared.fetch_add(1, std::memory_order_acq_rel);
+}
+// After the original selector ran. Two recordings of the assist working showed the game choosing the pop (state
+// 200) and then asking to end it twice: on the very next tick (a wipeout, 300), and again at the landing of the
+// flight the pop starts (a dismount, 504, one tick after touching down). That is what No Bail removes.
+// For 4 s after a pop the game chose itself, do the same swap, and only for that: a wipeout or dismount
+// request is turned into staying in the current state, for at most 0.4 s at a time so a real fall is not
+// held off for long.
+std::uint32_t contact_assist_after(std::uintptr_t selector, std::uint32_t current, std::uint32_t next, std::uint32_t kept) noexcept {
+    auto& a = contact_assist();
+    if (!a.enabled.load(std::memory_order_relaxed)) return kept;
+    const auto now = GetTickCount64();
+    if (current == 201 && next == 200 && a.latched.load(std::memory_order_relaxed)) {
+        Owner owner;
+        if (local_owner(selector, &Owner::selector, &owner)) {
+            a.pop_until.store(now + 4000, std::memory_order_relaxed);
+            a.hold_since.store(0, std::memory_order_relaxed);
+            a.latched.store(false, std::memory_order_relaxed);
+            a.consumed.store(true, std::memory_order_relaxed);
+        }
+        return kept;
+    }
+    const bool failing = next == wipeout_physics_state || next == offboard_physics_state;
+    if (!failing) { a.hold_since.store(0, std::memory_order_relaxed); return kept; }
+    if (now >= a.pop_until.load(std::memory_order_relaxed) || current == offboard_physics_state) return kept;
+    Owner owner;
+    if (!local_owner(selector, &Owner::selector, &owner)) return kept;
+    auto since = a.hold_since.load(std::memory_order_relaxed);
+    if (!since) { since = now; a.hold_since.store(now, std::memory_order_relaxed); }
+    if (now - since > 400) return kept;
+    cancel_wipeout_requests(owner.context);
+    reset_pending_causes(owner.causes);
+    a.holds.fetch_add(1, std::memory_order_acq_rel);
+    return current;
+}
