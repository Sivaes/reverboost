+        debug.contact_assist_seen = cleared;
+        logging::write(logging::Level::info, logging::Channel::skater,
+            std::format("Dark pop assist: cleared the bail flags (mask {:#x}) so the pop is judged first", contact_assist_last_mask()));
+    }
+}
