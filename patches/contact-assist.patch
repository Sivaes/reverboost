+struct ContactAssist {
+    std::atomic<bool> enabled{};
+    std::atomic<std::uint64_t> armed_until{}, cleared{};
+};
+ContactAssist& contact_assist() { static auto* value = new ContactAssist; return *value; }
+constexpr std::uintptr_t landing_request_offset = 0x13c8, landing_contact_offset = 0x13cc;
+constexpr unsigned landing_stage_bit = 0x4000000;
+constexpr LONG landing_contact_mask = 0x400;
+void contact_assist_apply(std::uintptr_t selector, std::uint32_t current) noexcept {
+    auto& a = contact_assist();
+    if (!a.enabled.load(std::memory_order_relaxed) || current != 201) return;
+    if (GetTickCount64() >= a.armed_until.load(std::memory_order_relaxed)) return;
+    Owner owner;
+    if (!local_owner(selector, &Owner::selector, &owner)) return;
+    unsigned request{}, contact{};
+    if (!read(owner.context + landing_request_offset, request) || !(request & landing_stage_bit)) return;
+    if (!read(owner.context + landing_contact_offset, contact) || !(contact & static_cast<unsigned>(landing_contact_mask))) return;
+    if (cancel_request(owner.context, landing_contact_offset, landing_contact_mask))
+        a.cleared.fetch_add(1, std::memory_order_acq_rel);
+}
