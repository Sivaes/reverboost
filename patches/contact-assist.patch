+void contact_assist_update(bool enabled, bool dpad_down) noexcept {
+    auto& a = contact_assist();
+    a.enabled.store(enabled, std::memory_order_relaxed);
+    if (enabled && dpad_down) a.armed_until.store(GetTickCount64() + 1200, std::memory_order_relaxed);
+}
