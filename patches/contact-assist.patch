+// ---- Dark pop contact assist ----------------------------------------------------
+// The work is done in the physics selector hook (no_bail.cpp). This tick reads D-pad Right, publishes it and
+// reports each time the landing-contact flag was cleared. Nothing is read until it is switched on.
+namespace {
+void contact_assist_tick(InteractiveDebug& debug, bool ready) {
+    if (!debug.contact_assist) { contact_assist_update(false, false); return; }
+    const bool allowed = ready && session_boosts_allowed() && !debug.noclip && !debug.park_editor;
+    ControllerInput pad;
+    DingoSDKOverlayReadControllerInput(&pad);
+    contact_assist_update(allowed, pad.available && (pad.buttons & 0x8) != 0);
+    const auto cleared = contact_assist_count();
